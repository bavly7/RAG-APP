APP_NAME=YOUR_APP_NAME
VERSION=YOUR_VERSION

LIST_FORMATE=["",""]
MAX_FILE_SIZE=MAX_NUMBER
FILE_CHUNCK_SIZE=NUMBER_CHUNCKING_LOAD

MONGODB_URL="mongodb://USERNAME:PASSWORD@localhost:YOURPORT"
MONGODB_DATABASE="DATABASE_NAME"

# Choose ONE generation backend at a time.
# To switch provider, change GENERATION_BACKEND and GENERATION_MODEL_ID together.
GENERATION_BACKEND="GROQ"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=""
COHERE_API_KEY=""
GROQ_API_KEY=""

# Examples:
#   GROQ   -> GENERATION_MODEL_ID="openai/gpt-oss-120b"
#   OPENAI -> GENERATION_MODEL_ID="gpt-3.5-turbo-0125"
GENERATION_MODEL_ID="openai/gpt-oss-120b"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1

TOP_P=1.0
STREAMING=false


# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"